# Server Runtime & App URL
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dizibrand_dev?schema=public"
# DIRECT_URL is optional if using connection pooler like Supabase/Neon
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dizibrand_dev?schema=public"

# Auth.js / NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dizibrand_super_secret_jwt_key_minimum_32_characters_long_for_development"

# Pluggable Service Providers (Use 'mock' for local development without external credentials)
STORAGE_PROVIDER="mock" # Options: 'mock', 's3', 'r2'
EMAIL_PROVIDER="mock"   # Options: 'mock', 'resend', 'sendgrid'
PAYMENT_PROVIDER="mock" # Options: 'mock', 'stripe', 'razorpay'
CALENDAR_PROVIDER="mock"# Options: 'mock', 'calcom', 'google'

# Third-Party Credentials (Optional in mock mode)
RESEND_API_KEY=""
EMAIL_FROM="DiziBrand Media <notifications@dizibrandmedia.com>"
SALES_NOTIFY_EMAIL="growth@dizibrandmedia.com"

STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_REGION=""
S3_ENDPOINT=""

NEXT_PUBLIC_CALCOM_LINK="dizibrand-media/strategy-call"

NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_READ_TOKEN=""
