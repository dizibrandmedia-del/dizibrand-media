generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum Role {
  SUPER_ADMIN
  MANAGEMENT
  SALES
  PROJECT_MANAGER
  EMPLOYEE
  FREELANCER
  CLIENT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  MEETING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum BudgetTier {
  UNDER_2500
  TIER_2500_5000
  TIER_5000_10000
  TIER_10000_25000
  ABOVE_25000
  NOT_SURE
  INR_UNDER_2L
  INR_2L_4L
  INR_4L_8L
  INR_8L_20L
  INR_ABOVE_20L
}

enum ProjectStatus {
  PLANNING
  KICKOFF
  ACTIVE
  ON_HOLD
  IN_REVIEW
  COMPLETED
  ARCHIVED
}

enum MilestoneStatus {
  UPCOMING
  IN_PROGRESS
  PENDING_CLIENT_APPROVAL
  APPROVED
  COMPLETED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  BLOCKED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProposalStatus {
  DRAFT
  INTERNAL_REVIEW
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  SENT_FOR_SIGNATURE
  EXECUTED
  AMENDED
  TERMINATED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOIDED
}

enum PaymentMethod {
  STRIPE
  RAZORPAY
  BANK_TRANSFER
  WIRE
}

enum TicketCategory {
  BUG
  CHANGE_REQUEST
  GENERAL_QUESTION
  ASSET_REQUEST
  BILLING
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_CLIENT_RESPONSE
  RESOLVED
  CLOSED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ROLE_CHANGE
  STATUS_CHANGE
  PAYMENT_RECORDED
  DELIVERABLE_APPROVED
}

// --------------------------------------------------------
// IDENTITY & RBAC
// --------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  phone         String?
  role          Role      @default(CLIENT)
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id])
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions              Session[]
  assignedLeads         Lead[]                  @relation("LeadSalesAssignee")
  conductedCalls        Call[]                  @relation("CallConductedBy")
  hostedMeetings        Meeting[]               @relation("MeetingHost")
  authoredNotes         Note[]                  @relation("NoteAuthor")
  createdProposals      Proposal[]              @relation("ProposalCreator")
  managedProjects       Project[]               @relation("ProjectManager")
  assignedTasks         Task[]                  @relation("TaskAssignee")
  submittedDeliverables Deliverable[]           @relation("DeliverableSubmitter")
  reviewedDeliverables  Deliverable[]           @relation("DeliverableReviewer")
  projectMemberships    ProjectMember[]
  authoredMessages      Message[]               @relation("MessageAuthor")
  createdTickets        SupportTicket[]         @relation("TicketCreator")
  assignedTickets       SupportTicket[]         @relation("TicketAssignee")
  freelancerProfile     FreelancerProfile?
  reviewedApplications  FreelancerApplication[] @relation("ApplicationReviewer")
  authoredBlogPosts     BlogPost[]              @relation("BlogAuthor")
  auditLogs             AuditLog[]              @relation("AuditActor")
  notifications         Notification[]
  uploadedFiles         FileAttachment[]        @relation("FileUploader")
  approvedMilestones    Milestone[]             @relation("MilestoneClientApprover")

  @@index([email])
  @@index([companyId])
  @@index([role])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

// --------------------------------------------------------
// CRM & LEAD MANAGEMENT
// --------------------------------------------------------

model Company {
  id            String   @id @default(cuid())
  name          String
  website       String?
  industryId    String?
  industry      Industry? @relation(fields: [industryId], references: [id])
  country       String
  city          String?
  annualRevenue String?
  employeeCount String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users          User[]
  contacts       Contact[]
  leads          Lead[]
  projects       Project[]
  proposals      Proposal[]
  contracts      Contract[]
  invoices       Invoice[]
  supportTickets SupportTicket[]
  notes          Note[]
  calls          Call[]
  meetings       Meeting[]
  files          FileAttachment[]
}

model Contact {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  email     String   @unique
  phone     String?
  jobTitle  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Lead {
  id                 String     @id @default(cuid())
  firstName          String
  lastName           String
  email              String
  phone              String?
  country            String
  companyName        String
  website            String?
  serviceId          String?
  service            Service?   @relation(fields: [serviceId], references: [id])
  serviceName        String?
  projectDescription String     @db.Text
  budgetTier         BudgetTier
  timeline           String?
  status             LeadStatus @default(NEW)
  score              Int        @default(0)
  scoreBreakdown     Json?
  source             String     @default("website_lead_form")
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  assignedToId       String?
  assignedTo         User?      @relation("LeadSalesAssignee", fields: [assignedToId], references: [id])
  companyId          String?
  company            Company?   @relation(fields: [companyId], references: [id])
  privacyConsent     Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  scoreHistory LeadScoreHistory[]
  calls        Call[]
  meetings     Meeting[]
  notes        Note[]
  proposals    Proposal[]
  projects     Project[]

  @@index([status])
  @@index([score])
  @@index([assignedToId])
  @@index([email])
  @@index([country])
}

model LeadScoreHistory {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scoreBefore Int
  scoreAfter  Int
  reason      String
  createdAt   DateTime @default(now())
}

model Call {
  id              String   @id @default(cuid())
  leadId          String?
  lead            Lead?    @relation(fields: [leadId], references: [id])
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id])
  conductedById   String
  conductedBy     User     @relation("CallConductedBy", fields: [conductedById], references: [id])
  callDate        DateTime
  durationSeconds Int?
  outcome         String?
  notes           String   @db.Text
  createdAt       DateTime @default(now())
}

model Meeting {
  id              String   @id @default(cuid())
  title           String
  leadId          String?
  lead            Lead?    @relation(fields: [leadId], references: [id])
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id])
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id])
  hostId          String
  host            User     @relation("MeetingHost", fields: [hostId], references: [id])
  scheduledAt     DateTime
  durationMinutes Int      @default(45)
  meetingUrl      String?
  calendarEventId String?
  status          String   @default("Scheduled")
  notes           String?
  createdAt       DateTime @default(now())
}

model Note {
  id        String   @id @default(cuid())
  content   String   @db.Text
  authorId  String
  author    User     @relation("NoteAuthor", fields: [authorId], references: [id])
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
}

model Activity {
  id          String   @id @default(cuid())
  actorId     String?
  entityType  String
  entityId    String
  action      String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

// --------------------------------------------------------
// COMMERCIALS, PROPOSALS & CONTRACTS
// --------------------------------------------------------

model Proposal {
  id             String         @id @default(cuid())
  proposalNumber String         @unique
  leadId         String?
  lead           Lead?          @relation(fields: [leadId], references: [id])
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])
  createdById    String
  createdBy      User           @relation("ProposalCreator", fields: [createdById], references: [id])
  title          String
  scopeOverview  String         @db.Text
  totalAmount    Decimal        @db.Decimal(12, 2)
  currency       String         @default("USD")
  status         ProposalStatus @default(DRAFT)
  validUntil     DateTime
  viewedAt       DateTime?
  acceptedAt     DateTime?
  pdfUrl         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  contracts Contract[]
}

model Contract {
  id             String         @id @default(cuid())
  contractNumber String         @unique
  proposalId     String?
  proposal       Proposal?      @relation(fields: [proposalId], references: [id])
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])
  title          String
  status         ContractStatus @default(DRAFT)
  signedDate     DateTime?
  effectiveDate  DateTime
  expiryDate     DateTime?
  documentUrl    String
  createdAt      DateTime       @default(now())
}

model Invoice {
  id                    String        @id @default(cuid())
  invoiceNumber         String        @unique
  companyId             String
  company               Company       @relation(fields: [companyId], references: [id])
  projectId             String?
  project               Project?      @relation(fields: [projectId], references: [id])
  amount                Decimal       @db.Decimal(12, 2)
  taxAmount             Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount           Decimal       @db.Decimal(12, 2)
  currency              String        @default("USD")
  status                InvoiceStatus @default(DRAFT)
  dueDate               DateTime
  paidAt                DateTime?
  stripePaymentIntentId String?
  razorpayOrderId       String?
  pdfUrl                String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  payments Payment[]

  @@index([companyId])
  @@index([status])
  @@index([dueDate])
}

model Payment {
  id                   String        @id @default(cuid())
  invoiceId            String
  invoice              Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount               Decimal       @db.Decimal(12, 2)
  currency             String
  method               PaymentMethod
  transactionReference String?
  status               String        @default("Success")
  paymentDate          DateTime      @default(now())
  createdAt            DateTime      @default(now())
}

// --------------------------------------------------------
// PROJECT DELIVERY, MILESTONES & TASKS
// --------------------------------------------------------

model Project {
  id            String        @id @default(cuid())
  projectCode   String        @unique
  name          String
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  leadId        String?
  lead          Lead?         @relation(fields: [leadId], references: [id])
  managerId     String?
  manager       User?         @relation("ProjectManager", fields: [managerId], references: [id])
  status        ProjectStatus @default(PLANNING)
  health        String        @default("Green")
  startDate     DateTime?
  targetDate    DateTime?
  completedDate DateTime?
  budget        Decimal?      @db.Decimal(12, 2)
  currency      String        @default("USD")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  milestones     Milestone[]
  tasks          Task[]
  deliverables   Deliverable[]
  members        ProjectMember[]
  invoices       Invoice[]
  supportTickets SupportTicket[]
  meetings       Meeting[]
  notes          Note[]
  files          FileAttachment[]
  messages       Message[]

  @@index([companyId])
  @@index([managerId])
  @@index([status])
}

model Milestone {
  id                       String          @id @default(cuid())
  projectId                String
  project                  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                    String
  description              String?
  order                    Int
  status                   MilestoneStatus @default(UPCOMING)
  dueDate                  DateTime?
  completedDate            DateTime?
  isClientApprovalRequired Boolean         @default(true)
  clientApprovedAt         DateTime?
  clientApprovedById       String?
  clientApprovedBy         User?           @relation("MilestoneClientApprover", fields: [clientApprovedById], references: [id])
  createdAt                DateTime        @default(now())

  tasks        Task[]
  deliverables Deliverable[]
}

model Task {
  id             String     @id @default(cuid())
  milestoneId    String
  milestone      Milestone  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project    @relation(fields: [projectId], references: [id])
  title          String
  description    String?    @db.Text
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)
  assignedToId   String?
  assignedTo     User?      @relation("TaskAssignee", fields: [assignedToId], references: [id])
  dueDate        DateTime?
  estimatedHours Decimal?   @db.Decimal(5, 2)
  actualHours    Decimal?   @db.Decimal(5, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  subtasks Subtask[]
  messages Message[]
  files    FileAttachment[]

  @@index([projectId])
  @@index([milestoneId])
  @@index([assignedToId])
  @@index([status])
}

model Subtask {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model Deliverable {
  id            String     @id @default(cuid())
  projectId     String
  project       Project    @relation(fields: [projectId], references: [id])
  milestoneId   String?
  milestone     Milestone? @relation(fields: [milestoneId], references: [id])
  title         String
  description   String?
  fileUrl       String?
  externalLink  String?
  status        String     @default("Draft")
  submittedById String
  submittedBy   User       @relation("DeliverableSubmitter", fields: [submittedById], references: [id])
  reviewedById  String?
  reviewedBy    User?      @relation("DeliverableReviewer", fields: [reviewedById], references: [id])
  feedback      String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  messages Message[]
}

model ProjectMember {
  id            String  @id @default(cuid())
  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleInProject String

  @@unique([projectId, userId])
}

// --------------------------------------------------------
// COLLABORATION, DOCUMENTS & SUPPORT
// --------------------------------------------------------

model FileAttachment {
  id           String   @id @default(cuid())
  fileName     String
  fileSize     Int
  mimeType     String
  s3Key        String
  s3Url        String
  uploadedById String
  uploadedBy   User     @relation("FileUploader", fields: [uploadedById], references: [id])
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  taskId       String?
  task         Task?    @relation(fields: [taskId], references: [id])
  createdAt    DateTime @default(now())
}

model Message {
  id             String       @id @default(cuid())
  content        String       @db.Text
  authorId       String
  author         User         @relation("MessageAuthor", fields: [authorId], references: [id])
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id])
  taskId         String?
  task           Task?        @relation(fields: [taskId], references: [id])
  deliverableId  String?
  deliverable    Deliverable? @relation(fields: [deliverableId], references: [id])
  isInternalOnly Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model SupportTicket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id])
  projectId    String?
  project      Project?       @relation(fields: [projectId], references: [id])
  createdById  String
  createdBy    User           @relation("TicketCreator", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?          @relation("TicketAssignee", fields: [assignedToId], references: [id])
  title        String
  description  String         @db.Text
  category     TicketCategory
  priority     Priority       @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([companyId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// --------------------------------------------------------
// TALENT & FREELANCER MANAGEMENT
// --------------------------------------------------------

model FreelancerProfile {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills                   String[]
  hourlyRate               Decimal?  @db.Decimal(8, 2)
  currency                 String    @default("USD")
  portfolioUrl             String?
  githubUrl                String?
  linkedinUrl              String?
  availabilityHoursPerWeek Int?
  isVetted                 Boolean   @default(false)
  vettedDate               DateTime?
  notes                    String?
}

model FreelancerApplication {
  id                 String    @id @default(cuid())
  fullName           String
  email              String    @unique
  phone              String?
  portfolioUrl       String
  primarySpecialty   String
  experienceYears    Int
  desiredHourlyRate  String
  resumeUrl          String?
  status             String    @default("Pending")
  reviewedById       String?
  reviewedBy         User?     @relation("ApplicationReviewer", fields: [reviewedById], references: [id])
  createdAt          DateTime  @default(now())
}

// --------------------------------------------------------
// CMS, EDITORIAL & CONTENT
// --------------------------------------------------------

model Service {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  tagline      String
  category     String
  description  String   @db.Text
  benefits     Json
  deliverables Json
  isFeatured   Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  leads       Lead[]
  caseStudies CaseStudy[]
}

model Industry {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  headline   String
  overview   String   @db.Text
  challenges Json
  solutions  Json
  order      Int      @default(0)

  companies   Company[]
  caseStudies CaseStudy[]
}

model CaseStudy {
  id                 String    @id @default(cuid())
  slug               String    @unique
  title              String
  clientName         String
  isVerified         Boolean   @default(false)
  verificationStatus String    @default("Pending verification")
  industryId         String?
  industry           Industry? @relation(fields: [industryId], references: [id])
  serviceId          String?
  service            Service?  @relation(fields: [serviceId], references: [id])
  challenge          String    @db.Text
  solution           String    @db.Text
  results            Json?
  featuredImage      String?
  isPublished        Boolean   @default(false)
  createdAt          DateTime  @default(now())
}

model TeamProfile {
  id           String   @id @default(cuid())
  fullName     String
  roleTitle    String
  bio          String   @db.Text
  avatarUrl    String?
  linkedinUrl  String?
  isLeadership Boolean  @default(false)
  order        Int      @default(0)
}

model BlogPost {
  id                 String    @id @default(cuid())
  slug               String    @unique
  title              String
  excerpt            String
  content            String    @db.Text
  authorId           String
  author             User      @relation("BlogAuthor", fields: [authorId], references: [id])
  category           String
  tags               String[]
  coverImage         String?
  readingTimeMinutes Int       @default(5)
  isPublished        Boolean   @default(false)
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  authorName  String
  authorTitle String
  companyName String
  content     String   @db.Text
  isVerified  Boolean  @default(false)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model CmsPage {
  id              String   @id @default(cuid())
  path            String   @unique
  metaTitle       String
  metaDescription String
  ogImage         String?
  contentJson     Json
  updatedAt       DateTime @updatedAt
}

// --------------------------------------------------------
// GOVERNANCE, ANALYTICS & AUDIT
// --------------------------------------------------------

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventName String
  userId    String?
  sessionId String?
  url       String
  referrer  String?
  country   String?
  metadata  Json?
  timestamp DateTime @default(now())

  @@index([eventName])
  @@index([timestamp])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id])
  actorEmail String?
  action     AuditAction
  entityType String
  entityId   String
  ipAddress  String?
  userAgent  String?
  changes    Json?
  createdAt  DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}
